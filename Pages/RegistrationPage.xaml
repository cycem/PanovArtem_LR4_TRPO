<Page x:Class="MassageSalon.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MassageSalon.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
            <TextBlock Text="Фамилия:"/>
            <TextBox x:Name="tbSurName" Height="22" Margin="0 0 0 8"/>

            <TextBlock Text="Имя:"/>
            <TextBox x:Name="tbName" Height="22" Margin="0 0 0 8"/>

            <TextBlock Text="Отчество:"/>
            <TextBox x:Name="tbFath" Height="22" Margin="0 0 0 8"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="tbLogin" Height="22" Margin="0 0 0 8"/>

            <TextBlock Text="Пароль (не менее 8 символов):"/>
            <PasswordBox x:Name="pbPassword" Height="22" Margin="0 0 0 8"/>

            <TextBlock Text="Почта"/>
            <TextBox x:Name="tbEmail" Height="22" Margin="0 0 0 8"/>
            
            <TextBlock Text="Номер телефона"/>
            <TextBox x:Name="tbPhone" Height="22" Margin="0 0 0 8"/>

            <Button Content="Регистрация" Height="30" Click="BtnRegister_Click"/>
            <Button Content="Назад к авторизации" Height="25" Margin="0 10 0 0" Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Page>
