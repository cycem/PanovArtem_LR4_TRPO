<Page x:Class="MassageSalon.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MassageSalon.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Width="60" Text="Логин:" VerticalAlignment="Center"/>
                <TextBox Name="TBoxLogin" Width="200" Height="25"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Width="60" Text="Пароль:" VerticalAlignment="Center"/>
                <PasswordBox Name="PBoxPassword" Width="200" Height="25"/>
            </StackPanel>
            <Button Name="BtnLogin" Click="BtnLogin_Click" Content="Войти"
                    Width="100" Margin="5"/>
            <Button Name="BtnRegistration" Click="BtnRegistration_Click"
                    Content="Создать учетную запись" Width="168" Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
